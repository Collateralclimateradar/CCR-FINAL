# Copy this file to a new file named ".env" and replace the values.
# NEVER upload the real ".env" file to GitHub.

POSTGRES_USER=ccr_user
POSTGRES_PASSWORD=CHANGE_ME_TO_A_LONG_RANDOM_PASSWORD
POSTGRES_DB=ccr

# Used when running the app directly (not through Docker Compose).
DATABASE_URL=postgresql+psycopg://ccr_user:CHANGE_ME_TO_A_LONG_RANDOM_PASSWORD@localhost:5432/ccr

ENVIRONMENT=development

# Login-free development routes. Keep this false everywhere except your own computer.
ENABLE_DEV_ROUTES=true

# Secret that signs login tokens. Leave EMPTY to keep login disabled.
# To enable login, set it to a long random value (at least 32 characters).
# NEVER reuse it anywhere else and NEVER upload the real value to GitHub.
JWT_SECRET=
LOG_LEVEL=INFO
